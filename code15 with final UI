    );
  }

  void _showItemDetails(QueryDocumentSnapshot<Map<String, dynamic>> document) {
    final data = document.data();
    final type = (data['type'] ?? 'borrowed').toString();
    final borrowed = type == 'borrowed';
    final name = (data['itemName'] ?? 'Item').toString();
    final person = (data['personName'] ?? '').toString();
    final description = (data['description'] ?? '').toString();
    final date = getItemReturnDate(document);

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (sheetContext) {
        return FractionallySizedBox(
          heightFactor: 0.88,
          child: Container(
            decoration: const BoxDecoration(
              color: _page,
              borderRadius: BorderRadius.vertical(top: Radius.circular(28)),
            ),
            child: SafeArea(
              child: Column(
                children: [
                  Padding(
                    padding: const EdgeInsets.fromLTRB(18, 12, 18, 4),
                    child: Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        IconButton(
                          tooltip: 'Close',
                          onPressed: () => Navigator.pop(sheetContext),
                          icon: const Icon(
                            Icons.arrow_back_ios_new_rounded,
                            size: 19,
                            color: _primaryDark,
                          ),
                        ),
                        PopupMenuButton<String>(
                          icon: const Icon(
                            Icons.more_vert_rounded,
                            color: _primaryDark,
                          ),
                          onSelected: (value) {
                            if (value == 'edit') {
                              Navigator.pop(sheetContext);
                              showEditForm(document);
                            } else if (value == 'delete') {
                              Navigator.pop(sheetContext);
                              confirmDelete(document.id, name);
                            }
                          },
                          itemBuilder: (context) => const [
                            PopupMenuItem(
                              value: 'edit',
                              child: Text('Edit Item'),
                            ),
                            PopupMenuItem(
                              value: 'delete',
                              child: Text('Delete Record'),
                            ),
                          ],
                        ),
                      ],
                    ),
                  ),
                  Expanded(
                    child: SingleChildScrollView(
                      padding: const EdgeInsets.fromLTRB(20, 8, 20, 28),
                      child: Column(
                        children: [
                          _itemIcon(name, borrowed, large: true),
                          const SizedBox(height: 12),
                          Text(
                            name,
                            textAlign: TextAlign.center,
                            style: const TextStyle(
                              color: _primaryDark,
                              fontSize: 22,
                              fontWeight: FontWeight.w800,
                            ),
                          ),
                          const SizedBox(height: 6),
                          _statusChip(
                            borrowed ? 'Borrowed' : 'Lent',
                            borrowed
                                ? const Color(0xffcdd4ff)
                                : const Color(0xffc7f2df),
                            borrowed ? _primary : const Color(0xff149b67),
                          ),
                          const SizedBox(height: 20),
                          if (person.trim().isNotEmpty)
                            _detailRow(
                              Icons.person_outline_rounded,
                              borrowed ? 'Borrowed from' : 'Lent to',
                              person,
                            ),
                          if (date != null)
                            _detailRow(
                              Icons.calendar_today_outlined,
                              'Due Date',
                              _formatDate(date),
                            ),
                          if (description.trim().isNotEmpty)
                            _detailRow(
                              Icons.notes_outlined,
                              'Notes',
                              description,
                            ),
                          const SizedBox(height: 18),
                          SizedBox(
                            width: double.infinity,
                            height: 48,
                            child: OutlinedButton.icon(
                              onPressed: () {
                                Navigator.pop(sheetContext);
                                showEditForm(document);
                              },
                              icon: const Icon(Icons.edit_outlined, size: 19),
                              label: const Text('Edit Item'),
                              style: OutlinedButton.styleFrom(
                                foregroundColor: _primaryDark,
                                side: const BorderSide(
                                  color: Color(0xffc9d1ff),
                                ),
                                shape: RoundedRectangleBorder(
                                  borderRadius: BorderRadius.circular(14),
                                ),
                              ),
                            ),
                          ),
                          const SizedBox(height: 10),
                          if (data['status']?.toString() != 'returned')
                            SizedBox(
                              width: double.infinity,
                              height: 48,
                              child: OutlinedButton.icon(
                                onPressed: () {
                                  Navigator.pop(sheetContext);
                                  returnItem(document.id);
                                },
                                icon: const Icon(Icons.check_rounded, size: 19),
                                label: const Text('Mark as Returned'),
                                style: OutlinedButton.styleFrom(
                                  foregroundColor: _primary,
                                  side: const BorderSide(
                                    color: Color(0xffc9d1ff),
                                  ),
                                  shape: RoundedRectangleBorder(
                                    borderRadius: BorderRadius.circular(14),
                                  ),
                                ),
                              ),
                            ),
                          if (data['status']?.toString() != 'returned')
                            const SizedBox(height: 10),
                          SizedBox(
                            width: double.infinity,
                            height: 48,
                            child: OutlinedButton.icon(
                              onPressed: () {
                                Navigator.pop(sheetContext);
                                confirmDelete(document.id, name);
                              },
                              icon: const Icon(
                                Icons.delete_outline_rounded,
                                size: 19,
                              ),
                              label: const Text('Delete Record'),
                              style: OutlinedButton.styleFrom(
                                foregroundColor: const Color(0xffef4b5f),
                                side: const BorderSide(
                                  color: Color(0xffffaeb8),
                                ),
                                shape: RoundedRectangleBorder(
                                  borderRadius: BorderRadius.circular(14),
                                ),
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
        );
      },
    );
  }

