  Widget _buildHistoryPage() {
    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
      stream: itemsCollection
          .where('ownerId', isEqualTo: userId)
          .where('status', isEqualTo: 'returned')
          .snapshots(),
      builder: (context, snapshot) {
        final docs = List<QueryDocumentSnapshot<Map<String, dynamic>>>.from(
          snapshot.data?.docs ??
              <QueryDocumentSnapshot<Map<String, dynamic>>>[],
        );

        docs.sort((a, b) {
          final aData = a.data();
          final bData = b.data();
          final aDate = aData['returnedAt'] is Timestamp
              ? (aData['returnedAt'] as Timestamp).toDate()
              : aData['createdAt'] is Timestamp
              ? (aData['createdAt'] as Timestamp).toDate()
              : DateTime.fromMillisecondsSinceEpoch(0);
          final bDate = bData['returnedAt'] is Timestamp
              ? (bData['returnedAt'] as Timestamp).toDate()
              : bData['createdAt'] is Timestamp
              ? (bData['createdAt'] as Timestamp).toDate()
              : DateTime.fromMillisecondsSinceEpoch(0);
          return bDate.compareTo(aDate);
        });

        return ListView(
          padding: const EdgeInsets.fromLTRB(16, 18, 16, 110),
          children: [
            Center(
              child: ConstrainedBox(
                constraints: const BoxConstraints(maxWidth: 560),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text(
                      'History',
                      style: TextStyle(
                        color: _primaryDark,
                        fontSize: 25,
                        fontWeight: FontWeight.w800,
                        letterSpacing: -.5,
                      ),
                    ),
                    const SizedBox(height: 4),
                    const Text(
                      'Your previous borrowing and lending records.',
                      style: TextStyle(color: _muted, fontSize: 13),
                    ),
                    const SizedBox(height: 17),
                    if (snapshot.connectionState == ConnectionState.waiting)
                      const Padding(
                        padding: EdgeInsets.all(45),
                        child: Center(child: CircularProgressIndicator()),
                      )
                    else if (snapshot.hasError)
                      _emptyState(
                        Icons.error_outline_rounded,
                        'Unable to load history',
                        'Please check your connection and try again.',
                      )
                    else if (docs.isEmpty)
                      _emptyState(
                        Icons.history_rounded,
                        'No history yet',
                        'Returned items will appear here.',
                      )
                    else
                      ...docs.map(_historyTile),
                  ],
                ),
              ),
            ),
          ],
        );
      },
    );
  }

