class HomePage extends StatefulWidget {
  final User user;

  const HomePage({super.key, required this.user});

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  final firestore = FirebaseFirestore.instance;
  final ImagePicker imagePicker = ImagePicker();

  CollectionReference<Map<String, dynamic>> get itemsCollection =>
      firestore.collection('items');

  CollectionReference<Map<String, dynamic>> get usersCollection =>
      firestore.collection('users');

  String get userId => widget.user.uid;

  final TextEditingController searchController = TextEditingController();

  String searchQuery = '';
  String itemTypeFilter = 'all';
  String dateFilter = 'all';

  late final Future<Map<String, dynamic>> profileFuture;
  late final Stream<QuerySnapshot<Map<String, dynamic>>> activeItemsStream;

  @override
  void initState() {
    super.initState();
    profileFuture = getProfile();
    activeItemsStream = itemsCollection
        .where('ownerId', isEqualTo: userId)
        .where('status', isEqualTo: 'active')
        .snapshots();
    _initializeNotificationsForUser();
  }

  Future<void> _initializeNotificationsForUser() async {
    await NotificationService.instance.requestPermissions();
    await rescheduleActiveReminders();
  }

  Future<void> rescheduleActiveReminders() async {
    if (kIsWeb) return;

    try {
      final snapshot = await itemsCollection
          .where('ownerId', isEqualTo: userId)
          .where('status', isEqualTo: 'active')
          .get();

      for (final document in snapshot.docs) {
        final data = document.data();
        final returnDate = data['returnDate'];
        if (returnDate is Timestamp) {
          await NotificationService.instance.scheduleReturnReminder(
            itemId: document.id,
            itemName: (data['itemName'] ?? 'Item').toString(),
            returnDate: returnDate.toDate(),
          );
        }
      }
    } catch (_) {
      // Notifications should never prevent the app from loading.
    }
  }

  Future<void> cancelActiveReminders() async {
    if (kIsWeb) return;

    try {
      final snapshot = await itemsCollection
          .where('ownerId', isEqualTo: userId)
          .where('status', isEqualTo: 'active')
          .get();

      for (final document in snapshot.docs) {
        await NotificationService.instance.cancelReminder(document.id);
      }
    } catch (_) {
      // Do not block logout if notification cleanup fails.
    }
  }

  void showError(String message) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(message), backgroundColor: Colors.red),
    );
  }

  void showSuccess(String message) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(message), backgroundColor: Colors.green),
    );
  }

  Future<void> ensureUserProfile() async {
    final user = FirebaseAuth.instance.currentUser;
    if (user == null) return;

    final ref = usersCollection.doc(user.uid);
    final snapshot = await ref.get();

    if (!snapshot.exists) {
      await ref.set({
        'email': user.email ?? '',
        'displayName': user.isAnonymous ? 'Guest' : '',
        'photoUrl': user.photoURL ?? '',
        'isGuest': user.isAnonymous,
        'createdAt': FieldValue.serverTimestamp(),
        'updatedAt': FieldValue.serverTimestamp(),
      });
    }
  }

  Future<void> saveProfile(String displayName) async {
    final name = displayName.trim();

    if (name.isEmpty) {
      showError('Please enter your name.');
      return;
    }

    try {
      final user = FirebaseAuth.instance.currentUser;
      if (user == null) return;

      await usersCollection.doc(user.uid).set({
        'email': user.email ?? '',
        'displayName': name,
        'photoUrl': user.photoURL ?? '',
        'photoBase64': '',
        'isGuest': user.isAnonymous,
        'updatedAt': FieldValue.serverTimestamp(),
      }, SetOptions(merge: true));

      await user.updateDisplayName(name);

      showSuccess('Profile updated successfully!');
    } catch (_) {
      showError('Unable to save your profile.');
    }
  }

  Future<String?> pickAndUploadProfilePicture(ImageSource source) async {
    try {
      final pickedFile = await imagePicker.pickImage(
        source: source,
        imageQuality: 55,
        maxWidth: 500,
        maxHeight: 500,
      );

      if (pickedFile == null) return null;

      final user = FirebaseAuth.instance.currentUser;
      if (user == null) return null;

      final bytes = await pickedFile.readAsBytes();
      final photoBase64 = base64Encode(bytes);

      await usersCollection.doc(user.uid).set({
        'photoBase64': photoBase64,
        'photoUrl': '',
        'updatedAt': FieldValue.serverTimestamp(),
      }, SetOptions(merge: true));

      return photoBase64;
    } on FirebaseException catch (e) {
      showError(e.message ?? 'Unable to save your profile picture.');
      return null;
    } catch (_) {
      showError('Unable to save your profile picture.');
      return null;
    }
  }

  void showProfilePictureOptions() {
    showModalBottomSheet(
      context: context,
      builder: (sheetContext) {
        return SafeArea(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              const Padding(
                padding: EdgeInsets.all(18),
                child: Text(
                  'Profile Picture',
                  style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
                ),
              ),
              ListTile(
                leading: const Icon(Icons.photo_library),
                title: const Text('Choose from Gallery'),
                onTap: () async {
                  Navigator.pop(sheetContext);
                  final url = await pickAndUploadProfilePicture(
                    ImageSource.gallery,
                  );
                  if (url != null) {
                    showSuccess('Profile picture updated!');
                    if (mounted) setState(() {});
                  }
                },
              ),
              ListTile(
                leading: const Icon(Icons.camera_alt),
                title: const Text('Take a Photo'),
                onTap: () async {
                  Navigator.pop(sheetContext);
                  final url = await pickAndUploadProfilePicture(
                    ImageSource.camera,
                  );
                  if (url != null) {
                    showSuccess('Profile picture updated!');
                    if (mounted) setState(() {});
                  }
                },
              ),
              const SizedBox(height: 8),
            ],
          ),
        );
      },
    );
  }

  Widget buildProfileAvatar({
    String photoUrl = '',
    String photoBase64 = '',
    required String displayName,
    double radius = 40,
    bool editable = false,
  }) {
    ImageProvider? imageProvider;

    if (photoBase64.trim().isNotEmpty) {
      try {
        imageProvider = MemoryImage(base64Decode(photoBase64));
      } catch (_) {}
    }

    if (imageProvider == null && photoUrl.trim().isNotEmpty) {
      imageProvider = NetworkImage(photoUrl);
    }

    final hasPhoto = imageProvider != null;
    final firstLetter = displayName.trim().isNotEmpty
        ? displayName.trim().substring(0, 1).toUpperCase()
        : 'P';

    return GestureDetector(
      onTap: editable ? showProfilePictureOptions : null,
      child: Stack(
        clipBehavior: Clip.none,
        children: [
          CircleAvatar(
            radius: radius,
            backgroundImage: imageProvider,
            child: hasPhoto
                ? null
                : Text(
                    firstLetter,
                    style: TextStyle(
                      fontSize: radius * .65,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
          ),
          if (editable)
            Positioned(
              right: -2,
              bottom: -2,
              child: Container(
                padding: const EdgeInsets.all(7),
                decoration: BoxDecoration(
                  color: Colors.blue,
                  shape: BoxShape.circle,
                  border: Border.all(
                    color: Theme.of(context).scaffoldBackgroundColor,
                    width: 2,
                  ),
                ),
                child: const Icon(
                  Icons.camera_alt,
                  color: Colors.white,
                  size: 16,
                ),
              ),
            ),
        ],
      ),
    );
  }

  // ==========================================================
  // PROFILE
  // ==========================================================

  void showProfile() {
    showDialog(
      context: context,
      builder: (dialogContext) {
        return FutureBuilder<Map<String, dynamic>>(
          future: getProfile(),
