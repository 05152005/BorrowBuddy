  List<QueryDocumentSnapshot<Map<String, dynamic>>> filterItems(
    List<QueryDocumentSnapshot<Map<String, dynamic>>> documents,
  ) {
    final query = searchQuery.trim().toLowerCase();
    final now = DateTime.now();
    final today = DateTime(now.year, now.month, now.day);
    final tomorrow = today.add(const Duration(days: 1));
    final nextWeek = today.add(const Duration(days: 8));

    return documents.where((document) {
      final data = document.data();
      final itemName = (data['itemName'] ?? '').toString().toLowerCase();
      final personName = (data['personName'] ?? '').toString().toLowerCase();
      final type = (data['type'] ?? '').toString();

      final matchesSearch =
          query.isEmpty ||
          itemName.contains(query) ||
          personName.contains(query);

      final matchesType = itemTypeFilter == 'all' || type == itemTypeFilter;

      final timestamp = data['returnDate'];
      final returnDate = timestamp is Timestamp ? timestamp.toDate() : null;
      final day = returnDate == null
          ? null
          : DateTime(returnDate.year, returnDate.month, returnDate.day);

      bool matchesDate = true;

      switch (dateFilter) {
        case 'overdue':
          matchesDate = day != null && day.isBefore(today);
          break;
        case 'today':
          matchesDate = day == today;
          break;
        case 'next7':
          matchesDate =
              day != null && !day.isBefore(tomorrow) && day.isBefore(nextWeek);
          break;
        case 'all':
        default:
          matchesDate = true;
      }

      return matchesSearch && matchesType && matchesDate;
    }).toList();
  }

  void clearFilters() {
    searchController.clear();
    setState(() {
      searchQuery = '';
      itemTypeFilter = 'all';
      dateFilter = 'all';
    });
  }

  String get dateFilterLabel {
    switch (dateFilter) {
      case 'overdue':
        return 'Overdue';
      case 'today':
        return 'Due Today';
      case 'next7':
        return 'Next 7 Days';
      case 'all':
      default:
        return 'All Dates';
    }
  }

  @override
  bool isSameDay(DateTime a, DateTime b) {
    return a.year == b.year && a.month == b.month && a.day == b.day;
  }

  DateTime? getItemReturnDate(
    QueryDocumentSnapshot<Map<String, dynamic>> document,
  ) {
    final value = document.data()['returnDate'];
    if (value is Timestamp) {
      return value.toDate();
    }
    return null;
  }

  int countItemsDueToday(
    List<QueryDocumentSnapshot<Map<String, dynamic>>> documents,
  ) {
    final now = DateTime.now();

    return documents.where((document) {
      final returnDate = getItemReturnDate(document);
      return returnDate != null && isSameDay(returnDate, now);
    }).length;
  }

  int countOverdueItems(
    List<QueryDocumentSnapshot<Map<String, dynamic>>> documents,
  ) {
    final today = DateTime(
      DateTime.now().year,
      DateTime.now().month,
      DateTime.now().day,
    );

    return documents.where((document) {
      final returnDate = getItemReturnDate(document);
      if (returnDate == null) return false;

      final dueDay = DateTime(
        returnDate.year,
        returnDate.month,
        returnDate.day,
      );

      return dueDay.isBefore(today);
    }).length;
  }

  List<QueryDocumentSnapshot<Map<String, dynamic>>> getReminderItems(
    List<QueryDocumentSnapshot<Map<String, dynamic>>> documents,
  ) {
    final now = DateTime.now();
    final today = DateTime(now.year, now.month, now.day);
    final sevenDaysFromNow = today.add(const Duration(days: 7));

    final reminders = documents.where((document) {
      final returnDate = getItemReturnDate(document);
      if (returnDate == null) return false;

      final dueDay = DateTime(
        returnDate.year,
        returnDate.month,
        returnDate.day,
      );

      return !dueDay.isAfter(sevenDaysFromNow);
    }).toList();

    reminders.sort((a, b) {
      final aDate = getItemReturnDate(a);
      final bDate = getItemReturnDate(b);
      if (aDate == null && bDate == null) return 0;
      if (aDate == null) return 1;
      if (bDate == null) return -1;
      return aDate.compareTo(bDate);
    });

    return reminders;
  }

  String reminderLabel(DateTime returnDate) {
    final now = DateTime.now();
    final today = DateTime(now.year, now.month, now.day);
    final dueDay = DateTime(returnDate.year, returnDate.month, returnDate.day);

    if (dueDay.isBefore(today)) {
      final days = today.difference(dueDay).inDays;
      return days == 1 ? 'Overdue by 1 day' : 'Overdue by $days days';
    }

    if (isSameDay(dueDay, today)) return 'Due today';

    final days = dueDay.difference(today).inDays;
    return days == 1 ? 'Due tomorrow' : 'Due in $days days';
  }

  Color reminderColor(DateTime returnDate) {
    final now = DateTime.now();
    final today = DateTime(now.year, now.month, now.day);
    final dueDay = DateTime(returnDate.year, returnDate.month, returnDate.day);

    if (dueDay.isBefore(today)) return Colors.red;
    if (isSameDay(dueDay, today)) return Colors.orange;
    return Colors.blue;
  }

