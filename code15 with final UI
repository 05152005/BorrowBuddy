  Widget _itemIcon(String name, bool borrowed, {bool large = false}) {
    final lower = name.toLowerCase();
    IconData icon = borrowed
        ? Icons.inventory_2_rounded
        : Icons.arrow_upward_rounded;
    Color bg = borrowed ? const Color(0xffe4e8ff) : const Color(0xffffefcf);
    Color fg = borrowed ? _primary : const Color(0xffe99a14);
    if (lower.contains('calculator')) {
      icon = Icons.calculate_rounded;
      bg = const Color(0xffe2e7ff);
      fg = _primary;
    }
    if (lower.contains('charger') || lower.contains('cable')) {
      icon = Icons.bolt_rounded;
      bg = const Color(0xffffefcf);
      fg = const Color(0xffed9a12);
    }
    if (lower.contains('book') || lower.contains('notebook')) {
      icon = Icons.menu_book_rounded;
      bg = const Color(0xffdff7eb);
      fg = const Color(0xff20ae73);
    }
    if (lower.contains('headphone') || lower.contains('earphone')) {
      icon = Icons.headphones_rounded;
      bg = const Color(0xffffe1e8);
      fg = const Color(0xffee4e75);
    }
    final size = large ? 46.0 : 40.0;
    return Container(
      width: size,
      height: size,
      decoration: BoxDecoration(color: bg, shape: BoxShape.circle),
      child: Icon(icon, color: fg, size: large ? 24 : 21),
    );
  }

