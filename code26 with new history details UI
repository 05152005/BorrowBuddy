    );

    DateTime selectedDate = data['returnDate'] is Timestamp
        ? (data['returnDate'] as Timestamp).toDate()
        : DateTime.now().add(const Duration(days: 7));

    bool saving = false;

    showDialog(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final isBorrowed = data['type'] == 'borrowed';

            return AlertDialog(
              title: const Text('Edit Item'),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    TextField(
                      controller: itemNameController,
                      textCapitalization: TextCapitalization.sentences,
                      decoration: const InputDecoration(
                        labelText: 'Item Name',
                        prefixIcon: Icon(Icons.inventory_2),
                        border: OutlineInputBorder(),
                      ),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: personController,
                      textCapitalization: TextCapitalization.words,
                      decoration: InputDecoration(
                        labelText: isBorrowed ? 'Owner Name' : 'Borrower Name',
                        prefixIcon: const Icon(Icons.person),
                        border: const OutlineInputBorder(),
                      ),
                    ),
                    const SizedBox(height: 12),
                    ListTile(
                      contentPadding: EdgeInsets.zero,
                      leading: const Icon(Icons.calendar_month),
                      title: const Text('Return Date'),
                      subtitle: Text(
                        '${selectedDate.day}/${selectedDate.month}/${selectedDate.year}',
                      ),
                      onTap: () async {
                        final picked = await showDatePicker(
                          context: context,
                          initialDate: selectedDate.isBefore(DateTime.now())
                              ? DateTime.now()
                              : selectedDate,
                          firstDate: DateTime.now(),
                          lastDate: DateTime(2100),
                        );

                        if (picked != null) {
                          setDialogState(() {
                            selectedDate = picked;
                          });
                        }
                      },
                    ),
                    TextField(
                      controller: descriptionController,
                      textCapitalization: TextCapitalization.sentences,
                      maxLines: 3,
                      decoration: const InputDecoration(
                        labelText: 'Description (optional)',
                        prefixIcon: Icon(Icons.notes),
                        border: OutlineInputBorder(),
                      ),
                    ),
                  ],
                ),
              ),
              actions: [
                TextButton(
                  onPressed: saving ? null : () => Navigator.pop(dialogContext),
                  child: const Text('Cancel'),
                ),
                ElevatedButton(
                  onPressed: saving
                      ? null
                      : () async {
                          final itemName = itemNameController.text.trim();
                          final personName = personController.text.trim();

                          if (itemName.isEmpty || personName.isEmpty) {
                            showError(
                              'Item name and person name are required.',
                            );
                            return;
                          }

                          setDialogState(() => saving = true);

                          try {
                            await itemsCollection.doc(document.id).update({
                              'itemName': itemName,
                              'personName': personName,
                              'returnDate': Timestamp.fromDate(selectedDate),
                              'description': descriptionController.text.trim(),
                            });

                            if (notificationsEnabled) {
                              await NotificationService.instance
                                  .scheduleReturnReminder(
                                    itemId: document.id,
                                    itemName: itemName,
                                    returnDate: selectedDate,
                                    includeDayBefore: reminderDayBefore,
                                  );
                            } else {
                              await NotificationService.instance.cancelReminder(
                                document.id,
                              );
                            }

                            showSuccess('Item updated successfully!');

                            if (dialogContext.mounted) {
                              Navigator.pop(dialogContext);
                            }
                          } on FirebaseException catch (e) {
                            showError(
                              e.message ?? 'Unable to update the item.',
                            );
                            if (dialogContext.mounted) {
                              setDialogState(() => saving = false);
                            }
                          } catch (_) {
                            showError('Unable to update the item.');
                            if (dialogContext.mounted) {
                              setDialogState(() => saving = false);
                            }
