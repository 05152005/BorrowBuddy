  Future<void> _changeEmail() async {
    final user = FirebaseAuth.instance.currentUser;
    if (user == null) return;
    if (user.isAnonymous) {
      _showInfoSheet(
        'Create an account first',
        'Guest accounts do not have an email address. Create an account from your Profile first.',
      );
      return;
    }
    if (!await _reauthenticateWithPassword()) return;

    final controller = TextEditingController(text: user.email ?? '');
    final result = await showDialog<String>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: const Text('Change email'),
        content: TextField(
          controller: controller,
          keyboardType: TextInputType.emailAddress,
          autofocus: true,
          decoration: const InputDecoration(
            labelText: 'New email address',
            prefixIcon: Icon(Icons.email_outlined),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext),
            child: const Text('Cancel'),
          ),
          ElevatedButton(
            onPressed: () =>
                Navigator.pop(dialogContext, controller.text.trim()),
            child: const Text('Update'),
          ),
        ],
      ),
    );
    controller.dispose();
    if (result == null || result.isEmpty || result == user.email) return;
    try {
      await user.verifyBeforeUpdateEmail(result);
      await usersCollection.doc(user.uid).set({
        'pendingEmail': result,
        'updatedAt': FieldValue.serverTimestamp(),
      }, SetOptions(merge: true));
      if (mounted)
        showSuccess(
          'A verification email was sent to the new address. Verify it to finish changing your email.',
        );
    } on FirebaseAuthException catch (e) {
      if (mounted)
        showError(
          e.code == 'email-already-in-use'
              ? 'That email address is already in use.'
              : 'Unable to change the email address. Please try again.',
        );
    } catch (_) {
      if (mounted)
        showError('Unable to change the email address. Please try again.');
    }
  }

  Future<void> _deleteAccount() async {
    final user = FirebaseAuth.instance.currentUser;
    if (user == null) return;
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: const Text('Delete account?'),
        content: const Text(
          'This permanently deletes your BorrowBuddy account and your stored item records. This action cannot be undone.',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: const Text('Cancel'),
          ),
          FilledButton(
            style: FilledButton.styleFrom(backgroundColor: Color(0xffef4b5f)),
            onPressed: () => Navigator.pop(dialogContext, true),
            child: const Text('Delete Account'),
          ),
        ],
      ),
    );
    if (confirmed != true) return;
    if (!user.isAnonymous && !await _reauthenticateWithPassword()) return;
    try {
      final items = await itemsCollection
          .where('ownerId', isEqualTo: user.uid)
          .get();
      for (final doc in items.docs) {
        await doc.reference.delete();
      }
      await usersCollection.doc(user.uid).delete();
      await NotificationService.instance.cancelAll();
      await user.delete();
    } on FirebaseAuthException catch (e) {
      if (mounted)
        showError(
          e.code == 'requires-recent-login'
              ? 'Please sign in again before deleting your account.'
              : 'Unable to delete your account. Please try again.',
        );
    } catch (_) {
      if (mounted)
        showError('Unable to delete your account. Please try again.');
    }
  }

