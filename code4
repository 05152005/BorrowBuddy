  Future<Map<String, dynamic>> getProfile() async {
    final user = FirebaseAuth.instance.currentUser;
    if (user == null) return {};

    await ensureUserProfile();

    final snapshot = await usersCollection.doc(user.uid).get();
    return snapshot.data() ?? {};
  }

  Future<void> addItem({
    required String type,
    required String itemName,
    required String personName,
    required DateTime returnDate,
    required String description,
  }) async {
    final name = itemName.trim();
    final person = personName.trim();
    final details = description.trim();

    if (name.isEmpty) {
      showError('Please enter the item name.');
      return;
    }

    if (person.isEmpty) {
      showError('Please enter the person\'s name.');
      return;
    }

    try {
      await itemsCollection.add({
        'itemName': name,
        'personName': person,
        'returnDate': Timestamp.fromDate(returnDate),
        'type': type,
        'description': details,
        'ownerId': userId,
        'status': 'active',
        'createdAt': FieldValue.serverTimestamp(),
      });

      showSuccess(
        type == 'borrowed' ? 'Borrowed item added!' : 'Lent item added!',
      );
    } on FirebaseException catch (e) {
      showError(e.message ?? 'Unable to save the item.');
    } catch (_) {
      showError('Unable to save the item.');
    }
  }

